 "19": [
  {
   "type": "goal",
   "text": "「〜だと思う」と自分の見立てを言える。"
  },
  {
   "type": "h",
   "text": "1. 公式：（言いたい文）＋ **जस्तो लाग्छ** (jasto lāgcha)"
  },
  {
   "type": "p",
   "text": "「〜のように感じる＝〜だと思う」。**文の最後にそのまま付ける**のがコツ。"
  },
  {
   "type": "table",
   "headers": [
    "文",
    "ローマ字",
    "意味"
   ],
   "rows": [
    [
     "भोलि पानी पर्छ **जस्तो लाग्छ**।",
     "bholi pānī parcha jasto lāgcha",
     "明日は雨が降ると思います"
    ],
    [
     "उ विद्यार्थी हो **जस्तो लाग्छ**।",
     "u vidyārthī ho jasto lāgcha",
     "彼は学生だと思います"
    ],
    [
     "यो काम गाह्रो छ **जस्तो लाग्छ**。",
     "yo kām gāhro cha jasto lāgcha",
     "この仕事は難しいと思います"
    ]
   ]
  },
  {
   "type": "note",
   "text": "英語の「I think (that) …」と違い、**思う内容が先、「जस्तो लाग्छ」が後**。語順が逆。"
  }
 ],
 "20": [
