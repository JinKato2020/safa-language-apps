   "headers": [
    "Way",
    "Formula",
    "Nuance"
   ],
   "rows": [
    [
     "① strong intent",
     "root + **न चाहन्छु** (-na cāhanchu)",
     "want to ~"
    ],
    [
     "② mood / preference",
     "**मलाई** + root + **न मन छ** (-na man cha)",
     "feel like ~ing"
    ]
   ]
  },
  {
   "type": "h",
   "text": "2. Examples"
  },
  {
   "type": "table",
   "headers": [
    "Sentence",
    "Romanized",
    "Meaning",
    "Way"
   ],
   "rows": [
    [
     "म पानी **पिउन चाहन्छु**।",
     "ma pānī piuna cāhanchu",
     "I want to drink water",
     "①"
    ],
    [
     "म घर **जान चाहन्छु**।",
     "ma ghar jāna cāhanchu",
     "I want to go home",
     "①"
    ],
    [
     "मलाई संगीत **सुन्न मन छ**।",
     "malāī saṅgīt sunna man cha",
     "I feel like listening to music",
     "②"
    ],
    [
     "मलाई साथीलाई **भेट्न मन छ**।",
     "malāī sāthīlāī bheṭna man cha",
     "I feel like meeting a friend",
     "②"
    ]
   ]
  },
  {
   "type": "note",
   "text": "① uses the subject \"म\", ② uses the subject \"**मलाई (to me)**\". ② is softer (mood/preference)."
  }
 ],
 "16": [
