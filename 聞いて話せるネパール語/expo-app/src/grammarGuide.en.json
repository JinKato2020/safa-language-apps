     "kati chiṭo!",
     "So fast!"
    ]
   ]
  },
  {
   "type": "h",
   "text": "2. Emphasis words"
  },
  {
   "type": "table",
   "headers": [
    "Word",
    "Romanized",
    "Meaning",
    "Example"
   ],
   "rows": [
    [
