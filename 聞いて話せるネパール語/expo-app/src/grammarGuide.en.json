 "19": [
  {
   "type": "goal",
   "text": "State your view with \"I think ~\"."
  },
  {
   "type": "h",
   "text": "1. Formula: (the statement) + **जस्तो लाग्छ** (jasto lāgcha)"
  },
  {
   "type": "p",
   "text": "\"It seems/I think ~\". The trick: **attach it at the end of the sentence**."
  },
  {
   "type": "table",
   "headers": [
    "Sentence",
    "Romanized",
    "Meaning"
   ],
   "rows": [
    [
     "भोलि पानी पर्छ **जस्तो लाग्छ**।",
     "bholi pānī parcha jasto lāgcha",
     "I think it will rain tomorrow"
    ],
    [
     "उ विद्यार्थी हो **जस्तो लाग्छ**।",
     "u vidyārthī ho jasto lāgcha",
     "I think he is a student"
    ],
    [
     "यो काम गाह्रो छ **जस्तो लाग्छ**。",
     "yo kām gāhro cha jasto lāgcha",
     "I think this work is difficult"
    ]
   ]
  },
  {
   "type": "note",
   "text": "Unlike English \"I think (that) …\", in Nepali **the idea comes first, and \"जस्तो लाग्छ\" comes last** — the order is reversed."
  }
 ],
 "20": [
  {
