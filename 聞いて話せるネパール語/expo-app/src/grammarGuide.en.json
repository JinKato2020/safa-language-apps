 "29": [
  {
   "type": "goal",
   "text": "Say \"make/have (someone) ~\"."
  },
  {
   "type": "h",
   "text": "1. Two ways"
  },
  {
   "type": "table",
   "headers": [
    "Way",
    "Formula",
    "Example"
   ],
   "rows": [
    [
     "① special verb",
     "feed = **खुवाउनु**, have-read = **पढाउनु**, put-to-sleep = **सुताउनु**",
     "—"
    ],
    [
     "② make ~",
     "root + **न लगाउनु** (-na lagāunu)",
     "गर्न लगाउनु (make do)"
    ]
   ]
  },
  {
   "type": "h",
   "text": "2. The person made to do it takes **~लाई**; the subject takes **~ले**"
  },
  {
   "type": "table",
   "headers": [
    "Sentence",
    "Romanized",
    "Meaning"
   ],
   "rows": [
    [
     "आमाले बच्चालाई औषधि **खुवाउनुहुन्छ**।",
     "āmāle baccālāī auṣadhi khuvāunuhuncha",
     "Mother feeds the child medicine"
    ],
    [
     "शिक्षकले विद्यार्थीलाई किताब **पढाउनुहुन्छ**।",
     "śikṣakle vidyārthīlāī kitāb paḍhāunuhuncha",
     "The teacher has the students read the book"
    ],
    [
     "बुबाले मलाई कार **चलाउन लगाउनुभयो**।",
     "bubāle malāī kār calāuna lagāunubhayo",
     "Father made me drive the car"
    ],
    [
     "बुबाले मलाई स्कूल **पठाउनुभयो**।",
     "bubāle malāī skūl paṭhāunubhayo",
     "Father sent me to school"
    ]
   ]
  },
  {
   "type": "note",
   "text": "\"the one who makes\" = subject + **ले**; \"the one made to do it\" = **~लाई**. Keep both."
  }
 ],
 "30": [
  {
   "type": "goal",
   "text": "Say \"(someone) said that ~\"."
  },
  {
   "type": "h",
   "text": "1. Formula: (the quoted content) + **भन्यो／भनिन्／भन्नुभयो** (said)"
  },
  {
   "type": "table",
   "headers": [
    "Speaker",
    "\"said\"",
    "Romanized"
   ],
   "rows": [
    [
     "he",
     "भन्यो",
     "bhanyo"
    ],
    [
     "she",
     "भनिन्",
     "bhanin"
    ],
    [
     "polite",
     "भन्नुभयो",
     "bhannubhayo"
    ]
   ]
  },
  {
   "type": "h",
   "text": "2. Examples (content first, \"said\" last)"
  },
  {
   "type": "table",
   "headers": [
    "Sentence",
    "Romanized",
    "Meaning"
   ],
   "rows": [
    [
     "उसले **आउँछु भन्यो**।",
     "usle āũchu bhanyo",
     "He said he will come"
    ],
    [
     "उसले **जाँदिनँ भनिन्**।",
     "usle jā̃dinã bhanin",
     "She said she won't go"
    ],
    [
     "शिक्षकले **भोलि परीक्षा छ भन्नुभयो**।",
     "śikṣakle bholi parīkṣā cha bhannubhayo",
     "The teacher said there is an exam tomorrow"
    ],
    [
     "आमाले **चाँडो सुत भन्नुभयो**。",
     "āmāle cā̃ḍo sut bhannubhayo",
     "Mother said to go to sleep early"
    ]
   ]
  },
  {
   "type": "note",
   "text": "Nepali has no separate word for \"that\"; you **place the quote directly and put भन्यो at the end**. The order matches the idea → \"said\"."
  }
 ]
}