 "14": [
  {
   "type": "goal",
   "text": "Describe how an action is done (\"fast\", \"slowly\", \"always\")."
  },
  {
   "type": "h",
   "text": "1. Formula: put the adverb **before the verb**"
  },
  {
   "type": "table",
   "headers": [
    "Adverb",
    "Romanized",
    "Meaning"
   ],
   "rows": [
    [
     "छिटो",
     "chiṭo",
     "fast"
    ],
    [
