    [
     "चिठी **लेखियो**।",
     "ciṭhī lekhiyo",
     "The letter was written"
    ],
    [
     "झ्याल **फुटाइयो**。",
     "jhyāl phuṭāiyo",
     "The window was broken"
    ],
